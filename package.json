{
  "name": "stockwise",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "knip": "knip",
    "jscpd": "jscpd apps packages",
    "dev:api": "pnpm --filter @stockwise/api dev",
    "dev:web": "pnpm --filter @stockwise/web dev",
    "dev": "pnpm --parallel dev"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3"
  }
}
