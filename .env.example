# Stockan Platform Environment Configuration Example
# Copy this file to .env or set environment variables in deployment.

# Node & Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database & Cache (Postgres & Redis)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockan?schema=public
REDIS_URL=redis://localhost:6379

# Market Data Ingestion Provider ('mock' | 'stooq' | 'alphavantage' | 'finnhub')
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=

# AI Reasoning & Tool Orchestration Engine ('deterministic' | 'openai' | 'anthropic')
LLM_PROVIDER=deterministic
LLM_API_KEY=

# API Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Web Frontend (Public API Base)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
